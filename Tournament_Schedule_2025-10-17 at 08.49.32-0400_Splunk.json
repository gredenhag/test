  "dataSources": {
    "ds_Ty6BhrvE": {
      "type": "ds.search",
      "options": {
        "enableSmartSources": true,
        "refresh": "300s",
        "refreshType": "delay",
        "query": "| inputlookup TournamentInfo.csv\n| inputlookup append=t TournamentInfoArchive.csv",
        "queryParameters": {
          "earliest": "@w0",
          "latest": "now"
        }
      },
      "name": "parent_search"
    },
    "ds_DMGZsESJ": {
      "type": "ds.chain",
      "options": {
        "enableSmartSources": true,
        "extend": "ds_Ty6BhrvE",
        "query": "| stats count by Tour_Name"
      },
      "name": "chain_Tour_search"
    },
    "ds_TinnO6LV": {
      "type": "ds.chain",
      "options": {
        "enableSmartSources": true,
        "extend": "ds_Ty6BhrvE",
        "query": "| search Tour_Name=\"$Tour$\"\n| search Week IN ($Weeks$)\n| search Year=$Year$\n| search Truck=$Truck$\n| search Scoreboard_Truck=$Scoreboard_Truck$\n| search TZ_desc=$TZ$\n| table TID,Tour_Name,Tournament_Name,Truck,Scoreboard_Truck,Course_Name,Course_Number,ScoreLevel,StartDate,EndDate,TZ_desc,Week,City,State,Country"
      },
      "name": "chain_table_search"
    },
    "ds_obRlqkPj": {
      "type": "ds.chain",
      "options": {
        "extend": "ds_Ty6BhrvE",
        "query": "| stats count by Year",
        "enableSmartSources": true
      },
      "name": "chain_Year_search"
    },
    "ds_IrNzZmiH": {
      "type": "ds.chain",
      "options": {
        "enableSmartSources": true,
        "extend": "ds_Ty6BhrvE",
        "query": "| stats count by Week"
      },
      "name": "chain_Week_search"
    },
    "ds_pMw6l0Kk": {
      "type": "ds.chain",
      "options": {
        "extend": "ds_Ty6BhrvE",
        "enableSmartSources": true,
        "query": "| stats count by Truck"
      },
      "name": "chain_Truck_search"
    },
    "ds_vNJj8oxP": {
      "type": "ds.chain",
      "options": {
        "extend": "ds_Ty6BhrvE",
        "enableSmartSources": true,
        "query": "| stats count by Scoreboard_Truck"
      },
      "name": "chain_Scoreboard_Truck_search"
    },
    "ds_7MqTPuGQ": {
      "type": "ds.chain",
      "options": {
        "extend": "ds_Ty6BhrvE",
        "enableSmartSources": true,
        "query": "| stats count by TZ_desc"
      },
      "name": "Search_1"
    }
  },
